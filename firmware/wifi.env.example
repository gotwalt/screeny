# WiFi credentials for a `--features bench-wifi` build ONLY: a default build embeds none
# and joins from the device's settings store. Copy to firmware/wifi.env (gitignored)
# or to ~/.config/screeny/wifi.env (outside the repo, shared by every git worktree),
# or set both as environment variables. See firmware/build.rs for the lookup order.
# The SSID is case-sensitive. 2.4 GHz only: the ESP32 cannot see 5 GHz networks.
SCREENY_WIFI_SSID=Example-Wifi1
SCREENY_WIFI_PASSWORD=password9
